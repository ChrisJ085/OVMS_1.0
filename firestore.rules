rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------------
    // 1. Core Authentication & Profile Helpers
    // ------------------------------------------------------------------------
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function getUserProfile() {
      return (request.auth != null && request.auth.uid != null) ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data : null;
    }

    function isAccountActive() {
      let p = getUserProfile();
      return isAuthenticated() && p != null && (p.accountStatus == 'ACTIVE' || !('accountStatus' in p) || p.accountStatus == 'active');
    }

    // ------------------------------------------------------------------------
    // 2. Role Verification
    // ------------------------------------------------------------------------
    function isSuperuser() {
      let p = getUserProfile();
      return isAuthenticated() && p != null && p.role == 'PLATFORM_SUPERUSER';
    }

    function isRole(tenantId, roleName) {
      let profile = getUserProfile();
      return isAccountActive() &&
             profile != null && profile.role == roleName &&
             tenantId != null &&
             profile.tenantId == tenantId;
    }

    function isTenantAdmin(tenantId) { return isRole(tenantId, 'TENANT_ADMIN'); }
    function isPlanner(tenantId) { return isRole(tenantId, 'PLANNER'); }
    function isWarehouseOperator(tenantId) { return isRole(tenantId, 'WAREHOUSE_OPERATOR'); }
    function isViewer(tenantId) { return isRole(tenantId, 'VIEWER'); }
    function isDisplay(tenantId) { return isRole(tenantId, 'DISPLAY'); }

    // ------------------------------------------------------------------------
    // 3. Strict Tenant and Site Ownership
    // ------------------------------------------------------------------------
    function belongsToUserTenant(tenantId) {
      let profile = getUserProfile();
      return isAccountActive() && (isSuperuser() || (tenantId != null && profile.tenantId == tenantId));
    }

    function isAssignedToSite(siteId) {
      let profile = getUserProfile();
      return isSuperuser() ||
             (profile != null && profile.role == 'TENANT_ADMIN' && profile.tenantId != null) ||
             (profile != null && (
               siteId == null ||
               siteId == '' ||
               !('siteIds' in profile) ||
               profile.siteIds == null ||
               (profile.siteIds is list && siteId in profile.siteIds)
             ));
    }

    function getSiteId(doc) {
      return ('siteId' in doc.data) ? doc.data.siteId : null;
    }

    function hasTenantAccess(tenantId) {
      return isSuperuser() || belongsToUserTenant(tenantId);
    }

    function hasAssignedSiteAccess(tenantId, siteId) {
      return hasTenantAccess(tenantId) && isAssignedToSite(siteId);
    }

    function ownershipFieldsUnchanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(['tenantId', 'siteId']) == false;
    }

    function identityFieldsUnchanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'email']) == false;
    }

    // ------------------------------------------------------------------------
    // 4. Warehouse & Exception Allow-Lists
    // ------------------------------------------------------------------------
    function isOnlyUpdatingWarehouseFields() {
      let allowedFields = ['priorityStatus', 'progressQuantity', 'remainingQuantity', 'progressPercent', 'latestProgressNote', 'completedAt', 'cancelledAt', 'modifiedBy', 'modifiedDate'];
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedFields) &&
             (!('modifiedBy' in request.resource.data) || request.resource.data.modifiedBy == request.auth.uid) &&
             (!('progressPercent' in request.resource.data) || (request.resource.data.progressPercent >= 0 && request.resource.data.progressPercent <= 100)) &&
             (!('progressQuantity' in request.resource.data) || request.resource.data.progressQuantity >= 0);
    }
    
    function isOnlyPlannerApprovedFields() {
      let plannerFields = [
        'tenantId', 'siteId', 'status', 'sourceType', 'sourceRecommendationId',
        'productId', 'productCodeSnapshot', 'descriptionSnapshot', 'description', 'actionTypeId',
        'requestedQuantity', 'plannedQuantity', 'destinationId', 'priorityLevelId', 'instruction',
        'plannerReason', 'overflowDestinationId', 'actionTypeLabel', 'destinationLabel',
        'overflowDestinationLabel', 'priorityLevelLabel', 'supportingReasons',
        'planningContextSnapshot', 'startAt', 'expireAt', 'untilSwitchedOff',
        'priorityStatus', 'publishedAt', 'modifiedBy', 'modifiedDate', 'createdBy', 'createdDate',
        'title', 'actionRequired', 'priorityLevel', 'severity', 'destination', 'rank', 'sortOrder',
        'targetTime', 'productionLine', 'department', 'stage', 'startTime', 'expiryTime', 'planningNotes', 'notes'
      ];
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(plannerFields) &&
             (!(request.resource.data.diff(resource.data).affectedKeys().hasAny(['priorityStatus'])) || 
              request.resource.data.priorityStatus in ['DRAFT', 'SCHEDULED', 'ACTIVE', 'CANCELLED', 'EXPIRED', 'ARCHIVED']);
    }
    
    function isOnlyUpdatingWarehouseInventoryFields() {
      let allowedFields = ['quantityOnHand', 'availableQuantity', 'blockedQuantity', 'lastCountDate', 'modifiedBy', 'modifiedDate'];
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedFields) &&
             (!('modifiedBy' in request.resource.data) || request.resource.data.modifiedBy == request.auth.uid) &&
             (!('quantityOnHand' in request.resource.data) || request.resource.data.quantityOnHand >= 0) &&
             (!('availableQuantity' in request.resource.data) || request.resource.data.availableQuantity >= 0) &&
             (!('blockedQuantity' in request.resource.data) || request.resource.data.blockedQuantity >= 0);
    }

    function isOnlyUpdatingWarehouseExceptionFields() {
      let allowedFields = ['status', 'resolvedAt', 'resolutionNotes', 'assignedTo', 'modifiedBy', 'modifiedDate'];
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedFields) &&
             (!('modifiedBy' in request.resource.data) || request.resource.data.modifiedBy == request.auth.uid);
    }

    // ------------------------------------------------------------------------
    // Global Deny
    // ------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // ------------------------------------------------------------------------
    // Users
    // ------------------------------------------------------------------------
    match /users/{userId} {
      allow read: if isSuperuser() ||
                     (isAuthenticated() && request.auth.uid == userId) ||
                     (isAuthenticated() && isTenantAdmin(resource.data.tenantId) && ('role' in resource.data) && resource.data.role != 'PLATFORM_SUPERUSER');
                     
      allow create: if false; // Only trusted backend can create users
      
      allow update: if isSuperuser() ||
                       (isAuthenticated() && request.auth.uid == userId && identityFieldsUnchanged() && ownershipFieldsUnchanged() &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'jobTitle', 'requiresPasswordChange', 'passwordChangedAt', 'modifiedBy', 'modifiedDate', 'lastLoginAt']) &&
                        
                        (!('modifiedBy' in request.resource.data) || request.resource.data.modifiedBy == request.auth.uid)) ||
                       (isTenantAdmin(resource.data.tenantId) && identityFieldsUnchanged() && ownershipFieldsUnchanged() &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'jobTitle', 'role', 'siteIds', 'accountStatus', 'modifiedBy', 'modifiedDate']) &&
                        resource.data.role != 'PLATFORM_SUPERUSER' && request.resource.data.role != 'PLATFORM_SUPERUSER' &&
                        (!('modifiedBy' in request.resource.data) || request.resource.data.modifiedBy == request.auth.uid));
                        
      allow delete: if isSuperuser();
    }

    // ------------------------------------------------------------------------
    // Tenants & Sites & Settings
    // ------------------------------------------------------------------------
    match /tenants/{tenantId} {
      allow read: if hasTenantAccess(tenantId) && getUserProfile() != null && getUserProfile().role != 'DISPLAY';
      allow create, update, delete: if isSuperuser();
    }
    match /sites/{siteId} {
      allow read: if hasTenantAccess(resource.data.tenantId) && getUserProfile().role != 'DISPLAY';
      allow create, update: if isSuperuser() || (isTenantAdmin(request.resource.data.tenantId) && (request.method == 'create' || ownershipFieldsUnchanged()));
      allow delete: if isSuperuser();
    }
    match /siteSettings/{settingId} {
      allow read: if isSuperuser() || (hasAssignedSiteAccess(resource.data.tenantId, getSiteId(resource)) && (getUserProfile() != null && (getUserProfile().role != 'DISPLAY' || ('isSensitive' in resource.data && resource.data.isSensitive == false))));
      allow create, update: if isSuperuser() || (isTenantAdmin(request.resource.data.tenantId) && (request.method == 'create' || ownershipFieldsUnchanged()));
      allow delete: if isSuperuser();
    }
    
    // ------------------------------------------------------------------------
    // Display / Dashboard specific reads
    // ------------------------------------------------------------------------
    // DISPLAY accounts can only read specific collections.
    
    // ------------------------------------------------------------------------
    // Master Data
    // ------------------------------------------------------------------------
    match /products/{id} {
      allow read: if hasTenantAccess(resource.data.tenantId);
      allow create, update: if isSuperuser() || (isTenantAdmin(request.resource.data.tenantId) && (request.method == 'create' || ownershipFieldsUnchanged()));
      allow delete: if isSuperuser();
    }
    match /locations/{id} {
      allow read: if hasTenantAccess(resource.data.tenantId);
      allow create, update: if isSuperuser() || (isTenantAdmin(request.resource.data.tenantId) && (request.method == 'create' || ownershipFieldsUnchanged()));
      allow delete: if isSuperuser();
    }
    match /destinations/{id} {
      allow read: if hasTenantAccess(resource.data.tenantId);
      allow create, update: if isSuperuser() || (isTenantAdmin(request.resource.data.tenantId) && (request.method == 'create' || ownershipFieldsUnchanged()));
      allow delete: if isSuperuser();
    }
    match /productionLines/{id} {
      allow read: if hasTenantAccess(resource.data.tenantId);
      allow create, update: if isSuperuser() || (isTenantAdmin(request.resource.data.tenantId) && (request.method == 'create' || ownershipFieldsUnchanged()));
      allow delete: if isSuperuser();
    }
    match /unitsOfMeasure/{id} {
      allow read: if hasTenantAccess(resource.data.tenantId);
      allow create, update: if isSuperuser() || (isTenantAdmin(request.resource.data.tenantId) && (request.method == 'create' || ownershipFieldsUnchanged()));
      allow delete: if isSuperuser();
    }
    match /productCategories/{id} {
      allow read: if hasTenantAccess(resource.data.tenantId);
      allow create, update: if isSuperuser() || (isTenantAdmin(request.resource.data.tenantId) && (request.method == 'create' || ownershipFieldsUnchanged()));
      allow delete: if isSuperuser();
    }
    match /storageAreas/{id} {
      allow read: if hasTenantAccess(resource.data.tenantId);
      allow create, update: if isSuperuser() || (isTenantAdmin(request.resource.data.tenantId) && (request.method == 'create' || ownershipFieldsUnchanged()));
      allow delete: if isSuperuser();
    }
    match /actionTypes/{id} {
      allow read: if hasTenantAccess(resource.data.tenantId);
      allow create, update: if isSuperuser() || (isTenantAdmin(request.resource.data.tenantId) && (request.method == 'create' || ownershipFieldsUnchanged()));
      allow delete: if isSuperuser();
    }
    match /priorityLevels/{id} {
      allow read: if hasTenantAccess(resource.data.tenantId);
      allow create, update: if isSuperuser() || (isTenantAdmin(request.resource.data.tenantId) && (request.method == 'create' || ownershipFieldsUnchanged()));
      allow delete: if isSuperuser();
    }
    
    // ------------------------------------------------------------------------
    // Inventory
    // ------------------------------------------------------------------------
    match /inventoryBalances/{id} {
      allow read: if hasAssignedSiteAccess(resource.data.tenantId, getSiteId(resource));
      allow create: if isSuperuser() || 
                       isTenantAdmin(request.resource.data.tenantId) || 
                       (isWarehouseOperator(request.resource.data.tenantId) && isAssignedToSite(getSiteId(request.resource)));
      allow update: if isSuperuser() || 
                       (isTenantAdmin(resource.data.tenantId) && ownershipFieldsUnchanged()) ||
                       (isWarehouseOperator(resource.data.tenantId) && isAssignedToSite(getSiteId(resource)) && ownershipFieldsUnchanged() && isOnlyUpdatingWarehouseInventoryFields());
      allow delete: if isSuperuser();
    }
    match /inventoryMovements/{id} {
      allow read: if hasAssignedSiteAccess(resource.data.tenantId, getSiteId(resource)) && getUserProfile().role != 'DISPLAY';
      allow create: if isSuperuser() || 
                       isTenantAdmin(request.resource.data.tenantId) ||
                       (isWarehouseOperator(request.resource.data.tenantId) && isAssignedToSite(getSiteId(request.resource)));
      allow update: if isSuperuser();
      allow delete: if isSuperuser();
    }

    // ------------------------------------------------------------------------
    // Planning Data
    // ------------------------------------------------------------------------
    match /planningRules/{id} {
      allow read: if hasAssignedSiteAccess(resource.data.tenantId, getSiteId(resource)) && getUserProfile().role != 'DISPLAY';
      allow create, update: if isSuperuser() || 
                               isTenantAdmin(request.resource.data.tenantId) ||
                               ((isPlanner(request.resource.data.tenantId)) && 
                                isAssignedToSite(getSiteId(request.resource)) && 
                                (request.method == 'create' || ownershipFieldsUnchanged()));
      allow delete: if isSuperuser() || isTenantAdmin(resource.data.tenantId) || (isPlanner(resource.data.tenantId) && isAssignedToSite(getSiteId(resource)));
    }
    match /promotions/{id} {
      allow read: if hasAssignedSiteAccess(resource.data.tenantId, getSiteId(resource)) && getUserProfile().role != 'DISPLAY';
      allow create, update: if isSuperuser() || 
                               isTenantAdmin(request.resource.data.tenantId) ||
                               ((isPlanner(request.resource.data.tenantId)) && 
                                isAssignedToSite(getSiteId(request.resource)) && 
                                (request.method == 'create' || ownershipFieldsUnchanged()));
      allow delete: if isSuperuser() || isTenantAdmin(resource.data.tenantId) || (isPlanner(resource.data.tenantId) && isAssignedToSite(getSiteId(resource)));
    }
    match /promotionProductRules/{id} {
      allow read: if hasAssignedSiteAccess(resource.data.tenantId, getSiteId(resource)) && getUserProfile().role != 'DISPLAY';
      allow create, update: if isSuperuser() || 
                               isTenantAdmin(request.resource.data.tenantId) ||
                               ((isPlanner(request.resource.data.tenantId)) && 
                                isAssignedToSite(getSiteId(request.resource)) && 
                                (request.method == 'create' || ownershipFieldsUnchanged()));
      allow delete: if isSuperuser() || isTenantAdmin(resource.data.tenantId) || (isPlanner(resource.data.tenantId) && isAssignedToSite(getSiteId(resource)));
    }
    match /decisionConfigurations/{id} {
      allow read: if isSuperuser() || (isAuthenticated() && getUserProfile() != null && getUserProfile().role != 'DISPLAY' && (resource == null || hasAssignedSiteAccess(resource.data.tenantId, getSiteId(resource))));
      allow create, update: if isSuperuser() || 
                               isTenantAdmin(request.resource.data.tenantId) ||
                               ((isPlanner(request.resource.data.tenantId)) && 
                                isAssignedToSite(getSiteId(request.resource)) && 
                                (request.method == 'create' || ownershipFieldsUnchanged()));
      allow delete: if isSuperuser() || isTenantAdmin(resource.data.tenantId) || (isPlanner(resource.data.tenantId) && isAssignedToSite(getSiteId(resource)));
    }
    match /productionEvents/{id} {
      allow read: if hasAssignedSiteAccess(resource.data.tenantId, getSiteId(resource)) && getUserProfile().role != 'DISPLAY';
      allow create, update: if isSuperuser() || 
                               isTenantAdmin(request.resource.data.tenantId) ||
                               ((isPlanner(request.resource.data.tenantId)) && 
                                isAssignedToSite(getSiteId(request.resource)) && 
                                (request.method == 'create' || ownershipFieldsUnchanged()));
      allow delete: if isSuperuser() || isTenantAdmin(resource.data.tenantId) || (isPlanner(resource.data.tenantId) && isAssignedToSite(getSiteId(resource)));
    }
    match /recommendations/{id} {
      allow read: if hasAssignedSiteAccess(resource.data.tenantId, getSiteId(resource)) && getUserProfile().role != 'DISPLAY';
      allow create, update: if isSuperuser() || 
                               isTenantAdmin(request.resource.data.tenantId) ||
                               ((isPlanner(request.resource.data.tenantId)) && 
                                isAssignedToSite(getSiteId(request.resource)) && 
                                (request.method == 'create' || ownershipFieldsUnchanged()));
      allow delete: if isSuperuser() || isTenantAdmin(resource.data.tenantId) || (isPlanner(resource.data.tenantId) && isAssignedToSite(getSiteId(resource)));
    }

    // ------------------------------------------------------------------------
    // Operational Data
    // ------------------------------------------------------------------------
    match /priorities/{id} {
      allow read: if hasAssignedSiteAccess(resource.data.tenantId, getSiteId(resource));
      allow create: if isSuperuser() || isTenantAdmin(request.resource.data.tenantId) || (isPlanner(request.resource.data.tenantId) && isAssignedToSite(getSiteId(request.resource)));
      allow update: if isSuperuser() || 
                       isTenantAdmin(resource.data.tenantId) ||
                       (isPlanner(resource.data.tenantId) && isAssignedToSite(getSiteId(resource)) && ownershipFieldsUnchanged() && isOnlyPlannerApprovedFields()) ||
                       (isWarehouseOperator(resource.data.tenantId) && isAssignedToSite(getSiteId(resource)) && ownershipFieldsUnchanged() && isOnlyUpdatingWarehouseFields());
      allow delete: if isSuperuser() || isTenantAdmin(resource.data.tenantId) || (isPlanner(resource.data.tenantId) && isAssignedToSite(getSiteId(resource)));
    }
    match /priorityEvents/{id} {
      allow read: if hasAssignedSiteAccess(resource.data.tenantId, getSiteId(resource));
      allow create: if isSuperuser() || 
                       isTenantAdmin(request.resource.data.tenantId) || 
                       (isPlanner(request.resource.data.tenantId) && isAssignedToSite(getSiteId(request.resource))) ||
                       (isWarehouseOperator(request.resource.data.tenantId) && isAssignedToSite(getSiteId(request.resource)));
      allow update, delete: if isSuperuser();
    }
    match /announcements/{id} {
      allow read: if hasAssignedSiteAccess(resource.data.tenantId, getSiteId(resource));
      allow create, update: if isSuperuser() || isTenantAdmin(request.resource.data.tenantId) || (isPlanner(request.resource.data.tenantId) && isAssignedToSite(getSiteId(request.resource)) && (request.method == 'create' || ownershipFieldsUnchanged()));
      allow delete: if isSuperuser() || isTenantAdmin(resource.data.tenantId) || (isPlanner(resource.data.tenantId) && isAssignedToSite(getSiteId(resource)));
    }
    match /exceptions/{id} {
      allow read: if hasAssignedSiteAccess(resource.data.tenantId, getSiteId(resource));
      allow create: if isSuperuser() || 
                       isTenantAdmin(request.resource.data.tenantId) ||
                       ((isPlanner(request.resource.data.tenantId) || isWarehouseOperator(request.resource.data.tenantId)) && 
                        isAssignedToSite(getSiteId(request.resource)));
      allow update: if isSuperuser() || 
                       isTenantAdmin(resource.data.tenantId) ||
                       (isPlanner(resource.data.tenantId) && isAssignedToSite(getSiteId(resource)) && ownershipFieldsUnchanged()) ||
                       (isWarehouseOperator(resource.data.tenantId) && isAssignedToSite(getSiteId(resource)) && ownershipFieldsUnchanged() && isOnlyUpdatingWarehouseExceptionFields());
      allow delete: if isSuperuser() || isTenantAdmin(resource.data.tenantId) || (isPlanner(resource.data.tenantId) && isAssignedToSite(getSiteId(resource)));
    }

    // ------------------------------------------------------------------------
    // Production Plan Entries, Imports, Rows
    // ------------------------------------------------------------------------
    match /productionPlanEntries/{id} {
      allow read: if hasAssignedSiteAccess(resource.data.tenantId, getSiteId(resource)) && getUserProfile().role != 'DISPLAY';
      allow create, update: if isSuperuser() || 
                               isTenantAdmin(request.resource.data.tenantId) ||
                               ((isPlanner(request.resource.data.tenantId)) && 
                                isAssignedToSite(getSiteId(request.resource)) && 
                                (request.method == 'create' || ownershipFieldsUnchanged()));
      allow delete: if isSuperuser() || isTenantAdmin(resource.data.tenantId);
    }
    match /productionPlanImports/{importId} {
      allow read: if hasAssignedSiteAccess(resource.data.tenantId, getSiteId(resource)) && getUserProfile().role != 'DISPLAY';
      allow create: if isSuperuser() || isTenantAdmin(request.resource.data.tenantId) || (isPlanner(request.resource.data.tenantId) && isAssignedToSite(getSiteId(request.resource)));
      allow update: if isSuperuser() || 
                       isTenantAdmin(resource.data.tenantId) ||
                       (isPlanner(resource.data.tenantId) && 
                        isAssignedToSite(getSiteId(resource)) && 
                        ownershipFieldsUnchanged() &&
                        resource.data.status != 'COMMITTED');
      allow delete: if isSuperuser() || isTenantAdmin(resource.data.tenantId);
      
      match /rows/{rowId} {
        allow read: if hasAssignedSiteAccess(resource.data.tenantId, getSiteId(resource)) && getUserProfile().role != 'DISPLAY';
        allow create: if isSuperuser() || 
                         isTenantAdmin(request.resource.data.tenantId) ||
                         ((isPlanner(request.resource.data.tenantId)) && 
                          isAssignedToSite(getSiteId(request.resource)) &&
                          get(/databases/$(database)/documents/productionPlanImports/$(importId)).data.status != 'COMMITTED');
        allow update: if isSuperuser() || 
                         isTenantAdmin(resource.data.tenantId) ||
                         ((isPlanner(request.resource.data.tenantId)) && 
                          isAssignedToSite(getSiteId(resource)) && 
                          ownershipFieldsUnchanged() &&
                          get(/databases/$(database)/documents/productionPlanImports/$(importId)).data.status != 'COMMITTED');
        allow delete: if isSuperuser() || isTenantAdmin(resource.data.tenantId);
      }
    }
    match /productionLinePlanNotes/{id} {
      allow read: if hasAssignedSiteAccess(resource.data.tenantId, getSiteId(resource)) && getUserProfile().role != 'DISPLAY';
      allow create, update: if isSuperuser() || 
                               isTenantAdmin(request.resource.data.tenantId) ||
                               ((isPlanner(request.resource.data.tenantId)) && 
                                isAssignedToSite(getSiteId(request.resource)) && 
                                (request.method == 'create' || ownershipFieldsUnchanged()));
      allow delete: if isSuperuser() || isTenantAdmin(resource.data.tenantId);
    }
    match /importJobs/{id} {
      allow read: if hasAssignedSiteAccess(resource.data.tenantId, getSiteId(resource)) && getUserProfile().role != 'DISPLAY';
      allow create, update: if isSuperuser() || 
                               isTenantAdmin(request.resource.data.tenantId) ||
                               ((isPlanner(request.resource.data.tenantId)) && 
                                isAssignedToSite(getSiteId(request.resource)) && 
                                (request.method == 'create' || ownershipFieldsUnchanged()));
      allow delete: if isSuperuser() || isTenantAdmin(resource.data.tenantId);
    }

    // ------------------------------------------------------------------------
    // Audit Logs & Sessions
    // ------------------------------------------------------------------------
    match /auditLogs/{logId} {
      allow read: if isSuperuser() || 
                     (hasTenantAccess(resource.data.tenantId) && 
                      (isTenantAdmin(resource.data.tenantId) || isPlanner(resource.data.tenantId) || isWarehouseOperator(resource.data.tenantId)));
      allow create: if isAccountActive() &&
                     (!('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid) &&
                     (!('performedBy' in request.resource.data) || request.resource.data.performedBy == request.auth.uid) &&
                     ('userId' in request.resource.data || 'performedBy' in request.resource.data) &&
                     (isSuperuser() || request.resource.data.tenantId == getUserProfile().tenantId) &&
                     (!('siteId' in request.resource.data) || isAssignedToSite(request.resource.data.siteId)) &&
                     (!('createdDate' in request.resource.data) || request.resource.data.createdDate == request.time);
      allow update: if false;
      allow delete: if false;
    }
    match /sessions/{sessionId} {
      allow read: if isSuperuser() || 
                     (isTenantAdmin(resource.data.tenantId)) || 
                     (isAuthenticated() && request.auth.uid == resource.data.userId);
      allow create: if isAccountActive() && 
                     request.resource.data.userId == request.auth.uid &&
                     (isSuperuser() || request.resource.data.tenantId == getUserProfile().tenantId) &&
                     (!('siteId' in request.resource.data) || isAssignedToSite(request.resource.data.siteId)) &&
                     (!('createdDate' in request.resource.data) || request.resource.data.createdDate == request.time) &&
                     (!('loginAt' in request.resource.data) || request.resource.data.loginAt == request.time);
      allow update: if isAuthenticated() && request.auth.uid == resource.data.userId &&
                     request.resource.data.userId == resource.data.userId &&
                     request.resource.data.tenantId == resource.data.tenantId &&
                     (!('siteId' in request.resource.data) || isAssignedToSite(request.resource.data.siteId)) &&
                     (!('modifiedBy' in request.resource.data) || request.resource.data.modifiedBy == request.auth.uid) &&
                     (!('modifiedDate' in request.resource.data) || request.resource.data.modifiedDate == request.time) &&
                     request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                       'lastActivityAt', 'logoutAt', 'siteId', 'modifiedBy', 'modifiedDate', 'status'
                     ]);
      allow delete: if isSuperuser();
    }
  }
}
